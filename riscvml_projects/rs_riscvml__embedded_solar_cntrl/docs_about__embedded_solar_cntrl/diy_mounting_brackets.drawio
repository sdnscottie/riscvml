          <mxGeometry x="775" y="535" width="60" height="12" as="geometry" />
        </mxCell>
        <mxCell id="eaves-label" value="&lt;b&gt;CLAMP BRACKET&lt;/b&gt;&lt;br&gt;U-bolt clamps to&lt;br&gt;aluminum frame —&lt;br&gt;no holes in roof!" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#990000;" vertex="1" parent="1">
          <mxGeometry x="730" y="572" width="120" height="55" as="geometry" />
        </mxCell>

        <!-- Dimension annotations -->
        <mxCell id="dim-stroke" value="↕ 200mm actuator stroke = 16° tilt change" style="text;html=1;align=center;fontSize=9;fontColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="590" width="250" height="15" as="geometry" />
        </mxCell>

        <!-- ========== BRACKET TYPES BOM ========== -->
        <mxCell id="bom-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="650" height="380" as="geometry" />
        </mxCell>
        <mxCell id="bom-title" value="&lt;b&gt;DIY Bracket Types &amp;amp; Bill of Materials&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#7a5200;" vertex="1" parent="1">
          <mxGeometry x="60" y="728" width="400" height="25" as="geometry" />
        </mxCell>

        <!-- Type A: Hinge bracket -->
        <mxCell id="typeA-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="typeA-title" value="&lt;b&gt;Type A: Ridge Hinge Bracket (×5)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#7a5200;" vertex="1" parent="1">
          <mxGeometry x="70" y="765" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="typeA-detail" value="&lt;div style=&quot;text-align:left;font-size:10px;line-height:1.6;&quot;&gt;• &lt;b&gt;Material:&lt;/b&gt; 5mm galvanized steel L-bracket, 100×80mm&lt;br&gt;• &lt;b&gt;Top:&lt;/b&gt; Bolts to mounting rail (M8 T-bolt in rail slot)&lt;br&gt;• &lt;b&gt;Bottom:&lt;/b&gt; Clamps to roof frame with U-bolt&lt;br&gt;• &lt;b&gt;Pivot:&lt;/b&gt; M10×80 bolt acts as hinge pin&lt;br&gt;• &lt;b&gt;Placement:&lt;/b&gt; Ridge rail, between each panel pair + ends&lt;br&gt;• &lt;b&gt;Key:&lt;/b&gt; Nylon washer between bracket faces for smooth rotation&lt;br&gt;• &lt;b&gt;Cost:&lt;/b&gt; ~€3/bracket + €2 hardware = ~€25 total&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="70" y="788" width="280" height="115" as="geometry" />
        </mxCell>

        <!-- Type B: Actuator mount -->
        <mxCell id="typeB-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="760" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="typeB-title" value="&lt;b&gt;Type B: Actuator Mount Bracket (×2)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#7a5200;" vertex="1" parent="1">
          <mxGeometry x="380" y="765" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="typeB-detail" value="&lt;div style=&quot;text-align:left;font-size:10px;line-height:1.6;&quot;&gt;• &lt;b&gt;Material:&lt;/b&gt; 5mm galvanized steel U-bracket, 120×60mm&lt;br&gt;• &lt;b&gt;Upper:&lt;/b&gt; Pivots on eaves mounting rail (actuator rod end)&lt;br&gt;• &lt;b&gt;Lower:&lt;/b&gt; Fixed to roof frame (actuator body end)&lt;br&gt;• &lt;b&gt;Pivot:&lt;/b&gt; M10 clevis pin + R-clip on both ends&lt;br&gt;• &lt;b&gt;Placement:&lt;/b&gt; Center of eaves rail, one pair per actuator&lt;br&gt;• &lt;b&gt;Key:&lt;/b&gt; Must allow slight angular misalignment (±3°)&lt;br&gt;• &lt;b&gt;Cost:&lt;/b&gt; ~€5/bracket + €3 hardware = ~€16 total&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="380" y="788" width="280" height="115" as="geometry" />
        </mxCell>

        <!-- Type C: Mid-span clamps -->
        <mxCell id="typeC-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="920" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="typeC-title" value="&lt;b&gt;Type C: Panel Mid-Clamp (×20)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#7a5200;" vertex="1" parent="1">
          <mxGeometry x="70" y="925" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="typeC-detail" value="&lt;div style=&quot;text-align:left;font-size:10px;line-height:1.6;&quot;&gt;• &lt;b&gt;Material:&lt;/b&gt; Aluminum solar mid-clamp (off-the-shelf)&lt;br&gt;• &lt;b&gt;Size:&lt;/b&gt; Fits 30mm panel frame + 40×40 rail&lt;br&gt;• &lt;b&gt;Function:&lt;/b&gt; Clamps adjacent panels to shared rail&lt;br&gt;• &lt;b&gt;Placement:&lt;/b&gt; Between every panel pair on all 4 rails&lt;br&gt;• &lt;b&gt;Key:&lt;/b&gt; EPDM rubber pad prevents galvanic corrosion&lt;br&gt;• &lt;b&gt;Torque:&lt;/b&gt; 12 Nm (do not overtighten — cracks glass!)&lt;br&gt;• &lt;b&gt;Cost:&lt;/b&gt; ~€1.50/clamp = ~€30 total&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="70" y="948" width="280" height="115" as="geometry" />
        </mxCell>

        <!-- Type D: End clamps -->
        <mxCell id="typeD-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="920" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="typeD-title" value="&lt;b&gt;Type D: Panel End-Clamp (×8)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#7a5200;" vertex="1" parent="1">
          <mxGeometry x="380" y="925" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="typeD-detail" value="&lt;div style=&quot;text-align:left;font-size:10px;line-height:1.6;&quot;&gt;• &lt;b&gt;Material:&lt;/b&gt; Aluminum solar end-clamp (off-the-shelf)&lt;br&gt;• &lt;b&gt;Size:&lt;/b&gt; Fits 30mm panel frame + 40×40 rail&lt;br&gt;• &lt;b&gt;Function:&lt;/b&gt; Secures outer panels at array edges&lt;br&gt;• &lt;b&gt;Placement:&lt;/b&gt; Both ends of each row (4 rows × 2 ends)&lt;br&gt;• &lt;b&gt;Key:&lt;/b&gt; Critical for wind uplift resistance at edges&lt;br&gt;• &lt;b&gt;Torque:&lt;/b&gt; 12 Nm — same as mid-clamps&lt;br&gt;• &lt;b&gt;Cost:&lt;/b&gt; ~€2/clamp = ~€16 total&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="380" y="948" width="280" height="115" as="geometry" />
        </mxCell>

        <!-- ========== ASSEMBLY STEPS ========== -->
        <mxCell id="steps-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="710" y="720" width="650" height="380" as="geometry" />
        </mxCell>
        <mxCell id="steps-title" value="&lt;b&gt;Assembly Sequence — Ground-First Strategy&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#7b1fa2;" vertex="1" parent="1">
          <mxGeometry x="730" y="728" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="steps-text" value="&lt;div style=&quot;text-align:left;font-size:10px;line-height:1.8;&quot;&gt;&lt;b style=&quot;color:#7b1fa2;&quot;&gt;Phase 1: Ground Assembly (safe, no ladders)&lt;/b&gt;&lt;br&gt;1. Lay out 4× aluminum rails on ground, cut to 9.53m&lt;br&gt;2. Pre-attach all Type C mid-clamps and Type D end-clamps to rails&lt;br&gt;3. Slide panels into clamps, row by row (4 panels per rail pair)&lt;br&gt;4. Wire each string (MC4 connectors between panels)&lt;br&gt;5. Finger-tighten clamps — do NOT torque yet (needs alignment on roof)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7b1fa2;&quot;&gt;Phase 2: Roof Preparation&lt;/b&gt;&lt;br&gt;6. Attach Type A hinge brackets to ridge frame profile using U-bolts&lt;br&gt;7. Attach Type B actuator mount (lower) to eaves frame profile&lt;br&gt;8. Run actuator cable + string cables through roof frame channel&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7b1fa2;&quot;&gt;Phase 3: Lift &amp;amp; Attach (needs 2–3 people per row)&lt;/b&gt;&lt;br&gt;9. Lift pre-assembled row onto roof — ridge end first into hinge brackets&lt;br&gt;10. Insert M10 hinge pins through brackets + rail&lt;br&gt;11. Temporarily prop eaves end (wooden blocks at 8°)&lt;br&gt;12. Repeat for all 3 rows&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7b1fa2;&quot;&gt;Phase 4: Actuator &amp;amp; Final&lt;/b&gt;&lt;br&gt;13. Mount linear actuator between Type B brackets (body→roof, rod→rail)&lt;br&gt;14. Test tilt range: fully retracted = 8°, fully extended = 24°&lt;br&gt;15. Torque all clamps to 12 Nm&lt;br&gt;16. Connect strings to inverter, actuator to ESP32-P4 controller&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="730" y="755" width="610" height="335" as="geometry" />
        </mxCell>

        <!-- ========== TOTAL COST ========== -->
        <mxCell id="cost-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="650" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cost-title" value="&lt;b&gt;Estimated DIY Bracket Cost (excl. panels, actuator, ESP32)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#2d6a2d;" vertex="1" parent="1">
          <mxGeometry x="60" y="1128" width="500" height="25" as="geometry" />
        </mxCell>
        <mxCell id="cost-table" value="&lt;div style=&quot;font-size:11px;line-height:1.6;text-align:left;&quot;&gt;• 4× Aluminum mounting rails (40×40, 9.53m) — ~€120&lt;br&gt;• 5× Type A hinge brackets + hardware — ~€25&lt;br&gt;• 2× Type B actuator mount brackets — ~€16&lt;br&gt;• 20× Type C mid-clamps — ~€30&lt;br&gt;• 8× Type D end-clamps — ~€16&lt;br&gt;• U-bolts, M10 hinge pins, nylon washers, R-clips — ~€20&lt;br&gt;&lt;b&gt;Total bracket/rail cost: ~€227&lt;/b&gt; (vs. €500+ for commercial mounting system)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="1150" width="610" height="85" as="geometry" />
        </mxCell>

        <!-- ========== SAFETY WARNINGS ========== -->
        <mxCell id="safety-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;strokeWidth=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="710" y="1120" width="650" height="120" as="geometry" />
        </mxCell>
        <mxCell id="safety-title" value="&lt;b&gt;Safety &amp;amp; Structural Warnings&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="730" y="1128" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="safety-text" value="&lt;div style=&quot;font-size:10px;line-height:1.6;text-align:left;&quot;&gt;• &lt;b&gt;Structural engineer:&lt;/b&gt; Get the wintergarden frame rated for 354 kg + wind load before mounting!&lt;br&gt;• &lt;b&gt;Wind:&lt;/b&gt; At 24° tilt, panels catch wind — calculate uplift for your region (DIN EN 1991-1-4)&lt;br&gt;• &lt;b&gt;Insurance:&lt;/b&gt; Notify your building insurance (Wohngebäudeversicherung) about rooftop PV&lt;br&gt;• &lt;b&gt;Electrical:&lt;/b&gt; String Vmp = 165.6V — requires qualified electrician for inverter connection&lt;br&gt;• &lt;b&gt;Fall protection:&lt;/b&gt; Use harness + rope when working on glass roof — no walking on glass panels!&lt;br&gt;• &lt;b&gt;Grounding:&lt;/b&gt; All rails and frames must be bonded to building ground (PA rail + 6mm² Cu)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="730" y="1150" width="610" height="85" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
