        </mxCell>
        <mxCell id="hinge-label" value="&lt;b&gt;HINGE / PIVOT&lt;/b&gt;&lt;br&gt;M10 bolt through&lt;br&gt;bracket + rail clamp&lt;br&gt;(allows rotation)" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#cc5500;" vertex="1" parent="1">
