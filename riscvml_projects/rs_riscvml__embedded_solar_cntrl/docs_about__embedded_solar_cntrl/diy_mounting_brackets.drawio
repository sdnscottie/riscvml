<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="mounting-overview" name="Mounting Overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;DIY Mounting Brackets — Wintergarden Solar Array&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="12× TrinaSolar TSM-620NEG19RC.20 (2278×1134×30mm, 29.5 kg each) — 4 across × 3 rows, landscape&lt;br&gt;Bad Schwalbach, Germany (~50.1°N) — South-facing wintergarden roof — Tilt: 8° (roof) to 24° (actuator max)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="55" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- ========== CHALLENGE BOX ========== -->
        <mxCell id="challenge-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;strokeWidth=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="challenge-title" value="&lt;b&gt;The Biggest Problem: How to Easily Mount Solar Panels on a Wintergarden Roof?&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="700" height="25" as="geometry" />
        </mxCell>
        <mxCell id="challenge-text" value="&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.6;&quot;&gt;• &lt;b&gt;Weight:&lt;/b&gt; Each panel is 29.5 kg — total array weight ~354 kg + brackets + actuator hardware. Wintergarden glass roof not designed for this!&lt;br&gt;• &lt;b&gt;Glass roof:&lt;/b&gt; Cannot drill through glass panels — must clamp to aluminum frame profiles without penetrating the glazing seal&lt;br&gt;• &lt;b&gt;Wind load:&lt;/b&gt; Panels act as sails — brackets must resist uplift at 24° tilt without ripping off the frame&lt;br&gt;• &lt;b&gt;Variable tilt:&lt;/b&gt; Pivot point needed — panels must rotate 8°→24° via linear actuator without binding or rubbing&lt;br&gt;• &lt;b&gt;Waterproofing:&lt;/b&gt; No new holes in roof — all attachments must use existing frame bolts or non-penetrating clamps&lt;br&gt;• &lt;b&gt;Access:&lt;/b&gt; Working at height on a sloped glass roof — everything must be pre-assembled on the ground where possible&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="1280" height="95" as="geometry" />
        </mxCell>

        <!-- ========== TOP VIEW: PANEL LAYOUT ========== -->
        <mxCell id="topview-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f3ff;strokeColor=#4a86c8;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="650" height="440" as="geometry" />
        </mxCell>
        <mxCell id="topview-title" value="&lt;b&gt;Top View — Panel Layout on Wintergarden Roof&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4a86c8;" vertex="1" parent="1">
          <mxGeometry x="60" y="268" width="400" height="25" as="geometry" />
