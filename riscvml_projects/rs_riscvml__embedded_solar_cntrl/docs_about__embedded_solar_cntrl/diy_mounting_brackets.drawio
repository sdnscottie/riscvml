          <mxGeometry x="845" y="520" width="30" height="35" as="geometry" />
        </mxCell>
        <mxCell id="actuator-label" value="&lt;b&gt;Linear&lt;br&gt;Actuator&lt;/b&gt;&lt;br&gt;12/24V DC&lt;br&gt;200mm stroke" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="730" y="515" width="100" height="55" as="geometry" />
        </mxCell>

        <!-- Tilt angle arc -->
        <mxCell id="angle-8" value="8°" style="text;html=1;align=center;fontSize=9;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="475" width="30" height="15" as="geometry" />
