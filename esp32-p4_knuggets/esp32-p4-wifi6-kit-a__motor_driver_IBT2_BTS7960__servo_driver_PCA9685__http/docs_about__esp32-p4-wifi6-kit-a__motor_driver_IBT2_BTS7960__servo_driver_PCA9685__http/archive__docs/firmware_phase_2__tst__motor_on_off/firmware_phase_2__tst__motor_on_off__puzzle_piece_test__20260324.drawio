<mxfile host="app.diagrams.net" modified="2026-03-24T00:00:00.000Z" agent="CC" version="24.0.0">
  <diagram id="p2-tst" name="Firmware Phase 2 TST -- Motor ON/OFF Puzzle-Piece Test">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="t" value="&lt;b&gt;Firmware Phase 2 TST -- Motor ON/OFF Puzzle-Piece Test&lt;/b&gt;&lt;br&gt;BTS7960 IBT-2 Motor Driver -- Standalone I/O Verification for All-Purpose Use" style="text;html=1;align=center;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="700" height="45" as="geometry"/>
        </mxCell>

        <!-- ==================== PUZZLE-PIECE TESTING ==================== -->
        <mxCell id="s0" value="&lt;b&gt;PUZZLE-PIECE TESTING -- Verifying Input/Output Sensors for All-Purpose Use&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CE422B;fontColor=#ffffff;fontSize=14;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1100" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="puzzle_concept" value="&lt;b&gt;The Puzzle-Piece Architecture&lt;/b&gt;&lt;hr&gt;Each knugget is an &lt;b&gt;input or output sensor/actuator&lt;/b&gt;&lt;br&gt;tested in isolation as a standalone puzzle piece.&lt;br&gt;&lt;br&gt;Phase testing verifies the &lt;b&gt;raw I/O capability&lt;/b&gt; --&lt;br&gt;can the sensor read? Can the actuator drive?&lt;br&gt;The specific application (what it does) comes later.&lt;br&gt;&lt;br&gt;A tested puzzle piece is &lt;b&gt;all-purpose&lt;/b&gt; -- it can be&lt;br&gt;used in any project that needs that I/O capability.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#CE422B&quot;&gt;&lt;b&gt;Phase tests prove the I/O works.&lt;br&gt;Use cases decide what it's for.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#CE422B;strokeWidth=2;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="340" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="puzzle_phases" value="&lt;b&gt;Phase Testing Strategy&lt;/b&gt;&lt;hr&gt;&lt;table cellpadding=&quot;4&quot; style=&quot;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr style=&quot;background:#1a1a1a;color:white;&quot;&gt;&lt;td&gt;&lt;b&gt;Phase&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Tests&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Proves&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;td&gt;&lt;b&gt;Phase 1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GPIO + electrical&lt;/td&gt;&lt;td&gt;Pins output correct voltage&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;&quot;&gt;&lt;td&gt;&lt;b&gt;Phase 2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;I/O firmware&lt;/td&gt;&lt;td&gt;Sensor reads / actuator drives&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8cecc;&quot;&gt;&lt;td&gt;&lt;b&gt;Phase 2 TST&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Physical field test&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;I/O works in real environment&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fff2cc;&quot;&gt;&lt;td&gt;&lt;b&gt;Phase 3+&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Next puzzle piece&lt;/td&gt;&lt;td&gt;Next sensor/actuator I/O works&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e1d5e7;&quot;&gt;&lt;td&gt;&lt;b&gt;Integration&lt;/b&gt;&lt;/td&gt;&lt;td&gt;All pieces combined&lt;/td&gt;&lt;td&gt;All I/O works together in one system&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Use cases&lt;/b&gt; (what the I/O is used for) are documented&lt;br&gt;separately in &lt;b&gt;bts7960_usecases/&lt;/b&gt; and &lt;b&gt;pca9685_usecases/&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=10;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="430" y="130" width="360" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="puzzle_io" value="&lt;b&gt;This Puzzle Piece: BTS7960 Output&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Type:&lt;/b&gt; Output actuator (DC motor driver)&lt;br&gt;&lt;b&gt;I/O:&lt;/b&gt; PWM speed + enable pins&lt;br&gt;&lt;b&gt;Range:&lt;/b&gt; 0-20V, 0-43A continuous&lt;br&gt;&lt;br&gt;Once verified, this puzzle piece can&lt;br&gt;drive &lt;b&gt;any DC motor application&lt;/b&gt;:&lt;br&gt;-- conveyor belts&lt;br&gt;-- water pumps&lt;br&gt;-- winches&lt;br&gt;-- drill motors&lt;br&gt;-- robot drives&lt;br&gt;-- ... (see bts7960_usecases/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="130" width="240" height="190" as="geometry"/>
        </mxCell>

        <!-- ==================== SECTION 1: WHAT THIS TEST DOES ==================== -->
        <mxCell id="s1" value="&lt;b&gt;1. WHAT THIS TEST DOES -- Simple Motor ON/OFF Cycle&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;fontSize=14;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="1100" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="test_desc" value="&lt;b&gt;firmware_phase_2__on_off_test&lt;/b&gt;&lt;hr&gt;Minimal standalone firmware:&lt;br&gt;&lt;br&gt;1. Init GPIO enables (32, 22)&lt;br&gt;2. Init LEDC PWM on GPIO 25&lt;br&gt;3. Loop forever:&lt;br&gt;   -- Motor ON at 50% for 3 seconds&lt;br&gt;   -- Motor OFF for 3 seconds&lt;br&gt;&lt;br&gt;&lt;b&gt;No Wi-Fi, no SPA, no HTTP.&lt;/b&gt;&lt;br&gt;Just raw I/O output verification." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="250" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="test_purpose" value="&lt;b&gt;Purpose: I/O Physical Verification&lt;/b&gt;&lt;hr&gt;This test answers one question:&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#CE422B&quot;&gt;&lt;b&gt;&quot;Does the output actuator work&lt;br&gt;when deployed in the real world?&quot;&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Phase 1 proved electrical signals work.&lt;br&gt;Phase 2 proved the I/O firmware works.&lt;br&gt;&lt;br&gt;&lt;b&gt;Phase 2 TST proves the complete&lt;br&gt;physical assembly works end-to-end:&lt;/b&gt;&lt;br&gt;power supply, wiring, actuator, mounting." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="390" width="280" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="test_checklist" value="&lt;b&gt;Field Test Checklist&lt;/b&gt;&lt;hr&gt;&lt;table cellpadding=&quot;3&quot; style=&quot;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td&gt;[ ]&lt;/td&gt;&lt;td&gt;Motor spins at 50% duty&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[ ]&lt;/td&gt;&lt;td&gt;Motor stops cleanly (no coasting)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[ ]&lt;/td&gt;&lt;td&gt;3s timing feels correct&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[ ]&lt;/td&gt;&lt;td&gt;No overheating (BTS7960 / motor)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[ ]&lt;/td&gt;&lt;td&gt;Power supply holds under load&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[ ]&lt;/td&gt;&lt;td&gt;Wiring stays connected (vibration)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[ ]&lt;/td&gt;&lt;td&gt;ESP32-P4 does not brown out&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[ ]&lt;/td&gt;&lt;td&gt;Motor restarts after power cycle&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="650" y="390" width="230" height="180" as="geometry"/>
        </mxCell>

        <!-- ==================== SECTION 2: TIMING ==================== -->
        <mxCell id="s2" value="&lt;b&gt;2. TIMING DIAGRAM -- ON/OFF Cycle&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;fontSize=14;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1100" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="timing" value="&lt;pre style=&quot;font-size:11px;line-height:1.5;font-family:monospace;&quot;&gt;Speed %&lt;br&gt; 50 |  ___________              ___________              ___________&lt;br&gt;    | |           |            |           |            |           |&lt;br&gt;  0 |_|           |____________|           |____________|           |________&lt;br&gt;    &lt;br&gt;     |-- 3s ON --|-- 3s OFF --|-- 3s ON --|-- 3s OFF --|-- 3s ON --|&lt;br&gt;     |  50% duty  |  0% duty   |  50% duty  |  0% duty   |  50% duty  |&lt;br&gt;     |  R_EN=1   |  R_EN=0    |  R_EN=1   |  R_EN=0    |  R_EN=1   |&lt;br&gt;     |  L_EN=1   |  L_EN=0    |  L_EN=1   |  L_EN=0    |  L_EN=1   |&lt;br&gt;     |           |            |           |            |           |&lt;br&gt;     Cycle 1                  Cycle 2                  Cycle 3     ...&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D0D1A;fontColor=#2D9B3A;strokeColor=#333;fontSize=10;align=left;spacingLeft=10;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="800" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="timing_params" value="&lt;b&gt;Test Parameters&lt;/b&gt;&lt;hr&gt;&lt;table cellpadding=&quot;3&quot; style=&quot;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Speed:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;50% (duty 511/1023)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ON time:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;3000 ms&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;OFF time:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;3000 ms&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PWM freq:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;25 kHz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Resolution:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;10-bit (0-1023)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Motor V:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;~10V (50% of 20V)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Direction:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Forward only (LPWM n/c)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="890" y="650" width="200" height="180" as="geometry"/>
        </mxCell>

        <!-- ==================== SECTION 3: GPIO WIRING ==================== -->
        <mxCell id="s3" value="&lt;b&gt;3. GPIO WIRING -- Locked Pin Assignments Across All Knuggets&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;fontColor=#ffffff;fontSize=14;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="860" width="1100" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="wiring" value="&lt;pre style=&quot;font-size:11px;line-height:1.6;&quot;&gt;ESP32-P4 (40-Pin Header)              BTS7960 IBT-2 Module&lt;br&gt;========================              ===================&lt;br&gt;&lt;br&gt;&lt;b&gt;GPIO 25 (Left)&lt;/b&gt;  --- PWM 25kHz ---&gt;  Pin 7: RPWM (speed 0-100%)&lt;br&gt;                                        Pin 8: LPWM (disconnected -- fwd only)&lt;br&gt;&lt;b&gt;GPIO 32 (Right)&lt;/b&gt; --- HIGH/LOW ----&gt;  Pin 5: R_EN (enable)&lt;br&gt;&lt;b&gt;GPIO 22 (Right)&lt;/b&gt; --- HIGH/LOW ----&gt;  Pin 6: L_EN (enable)&lt;br&gt;&lt;b&gt;3V3     (Right)&lt;/b&gt; -----------------&gt;  Pin 1: VCC&lt;br&gt;&lt;b&gt;GND     (both)&lt;/b&gt;  -----------------&gt;  Pin 2: GND&lt;br&gt;&lt;br&gt;&lt;b&gt;20V Battery +&lt;/b&gt;   -----------------&gt;  Screw: B+&lt;br&gt;&lt;b&gt;20V Battery -&lt;/b&gt;   -----------------&gt;  Screw: B- (common GND)&lt;br&gt;&lt;b&gt;Motor +&lt;/b&gt;         &lt;-----------------  Screw: M+&lt;br&gt;&lt;b&gt;Motor -&lt;/b&gt;         &lt;-----------------  Screw: M-&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="60" y="910" width="600" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="gpio_lock" value="&lt;b&gt;Puzzle-Piece GPIO Lock&lt;/b&gt;&lt;hr&gt;These pin assignments are &lt;b&gt;identical&lt;/b&gt;&lt;br&gt;across all firmware phases and will&lt;br&gt;remain the same when integrated&lt;br&gt;into secure_wap_streamer.&lt;br&gt;&lt;br&gt;&lt;table cellpadding=&quot;3&quot; style=&quot;font-size:10px;&quot;&gt;&lt;tr style=&quot;background:#1a1a1a;color:white;&quot;&gt;&lt;td&gt;&lt;b&gt;GPIO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;I/O&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Knugget&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;&quot;&gt;&lt;td&gt;25&lt;/td&gt;&lt;td&gt;OUT: RPWM&lt;/td&gt;&lt;td&gt;BTS7960 motor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;32&lt;/td&gt;&lt;td&gt;OUT: R_EN&lt;/td&gt;&lt;td&gt;BTS7960 motor&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;&quot;&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;OUT: L_EN&lt;/td&gt;&lt;td&gt;BTS7960 motor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;I2C: SCL&lt;/td&gt;&lt;td&gt;PCA9685 servo&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;td&gt;21&lt;/td&gt;&lt;td&gt;I2C: SDA&lt;/td&gt;&lt;td&gt;PCA9685 servo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7, 8&lt;/td&gt;&lt;td&gt;I2C: Bus 0&lt;/td&gt;&lt;td&gt;MLX90640 thermal&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e1d5e7;&quot;&gt;&lt;td&gt;14-19&lt;/td&gt;&lt;td&gt;SDIO&lt;/td&gt;&lt;td&gt;C6 Wi-Fi&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="700" y="910" width="260" height="270" as="geometry"/>
        </mxCell>

        <!-- ==================== SECTION 4: BUILD + FLASH ==================== -->
        <mxCell id="s4" value="&lt;b&gt;4. BUILD + FLASH&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;fontSize=14;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="1210" width="1100" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="build_cmds" value="&lt;b&gt;Build + Flash Commands&lt;/b&gt;&lt;hr&gt;&lt;pre style=&quot;font-size:10px;line-height:1.5;&quot;&gt;source ~/Dropbox/scottsoft_sdn/esp-idf/export.sh&lt;br&gt;cd firmware_phase_2__on_off_test&lt;br&gt;idf.py build&lt;br&gt;idf.py -p /dev/ttyACM0 flash&lt;br&gt;&lt;br&gt;# Serial monitor (if available):&lt;br&gt;# /dev/ttyACM0 or /dev/ttyACM1 @ 115200&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="60" y="1260" width="350" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="serial_out" value="&lt;b&gt;Expected Serial Output&lt;/b&gt;&lt;hr&gt;&lt;pre style=&quot;font-size:10px;line-height:1.4;&quot;&gt;&lt;font color=&quot;#888&quot;&gt;========================================&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;  RISCVML -- BTS7960 ON/OFF Test&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;  3s ON (50%) / 3s OFF -- repeating&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;  RPWM=25  R_EN=32  L_EN=22&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;========================================&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2D9B3A&quot;&gt;[MOTOR] ON  speed=50% duty=511&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2D9B3A&quot;&gt;[CYCLE 1] ON -- 3 seconds&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;[MOTOR] OFF&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;[CYCLE 1] OFF -- 3 seconds&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2D9B3A&quot;&gt;[MOTOR] ON  speed=50% duty=511&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2D9B3A&quot;&gt;[CYCLE 2] ON -- 3 seconds&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888&quot;&gt;...&lt;/font&gt;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D0D1A;fontColor=#2D9B3A;strokeColor=#333;fontSize=10;align=left;spacingLeft=10;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="440" y="1260" width="350" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="config" value="&lt;b&gt;sdkconfig.defaults&lt;/b&gt;&lt;hr&gt;&lt;table cellpadding=&quot;3&quot; style=&quot;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Target:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;esp32p4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Flash:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;16 MB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;SPIRAM:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;HEX mode, 80 MHz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Console:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;UART default&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Note:&lt;/b&gt; No Wi-Fi, no esp_hosted.&lt;br&gt;Minimal config -- pure I/O test." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#E0E0E0;strokeColor=#555;fontSize=10;align=left;spacingLeft=10;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="820" y="1260" width="220" height="170" as="geometry"/>
        </mxCell>

        <!-- Anki Ref -->
        <mxCell id="anki" value="&lt;b&gt;Anki-Ref:&lt;/b&gt; 20260324_XXXXXX__BTS7960__firmware_phase_2__tst__motor_on_off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#1a1a1a;fontSize=11;align=left;spacingLeft=15;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="1500" width="600" height="30" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
