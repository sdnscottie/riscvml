<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-04-05T00:00:00.000Z" version="21.0.0" type="device">
  <diagram name="A121 Range Sensor — Specs + Pinout" id="a121-specs">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" background="#1a1a2e" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;SVBD: Acconeer A121 Range Sensor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#888&quot;&gt;Waveshare A121 Range Sensor Module — 60GHz mmWave Radar&lt;br&gt;SvBlock by SVB — riscvml.org&lt;/font&gt;" style="text;html=1;fontSize=20;fontColor=#00ff88;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="600" height="60" as="geometry" />
        </mxCell>

        <!-- ===== SPECIFICATIONS ===== -->
        <mxCell id="specs_header" value="&lt;b&gt;Specifications&lt;/b&gt;" style="text;html=1;fontSize=16;fontColor=#4488ff;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="400" height="25" as="geometry" />
        </mxCell>

        <mxCell id="specs" value="&lt;font style=&quot;font-size:12px;font-family:monospace&quot;&gt;&lt;b&gt;Sensor:&lt;/b&gt;       Acconeer A121 (PCR)&lt;br&gt;&lt;b&gt;Technology:&lt;/b&gt;  60GHz Pulsed Coherent Radar&lt;br&gt;&lt;b&gt;Range:&lt;/b&gt;       0.03m to 23m (3cm to 23m)&lt;br&gt;&lt;b&gt;Resolution:&lt;/b&gt;  ~2.5mm per step&lt;br&gt;&lt;b&gt;Interface:&lt;/b&gt;   SPI (to A121 chip)&lt;br&gt;&lt;b&gt;Module I/F:&lt;/b&gt;  UART + I2C + GPIO (to host)&lt;br&gt;&lt;b&gt;MCU:&lt;/b&gt;         STM32L431CBT6 (Arm Cortex-M4)&lt;br&gt;&lt;b&gt;Connector:&lt;/b&gt;   MX1.25 10-pin cable&lt;br&gt;&lt;b&gt;Voltage:&lt;/b&gt;     3.3V logic, 1.8V internal&lt;br&gt;&lt;b&gt;Standby:&lt;/b&gt;     &amp;lt; 1 uA (ENABLE low)&lt;br&gt;&lt;b&gt;Crystal:&lt;/b&gt;     24 MHz external&lt;br&gt;&lt;b&gt;Frequency:&lt;/b&gt;   60.5 GHz ISM band&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#4488ff;strokeWidth=2;fontSize=11;fontColor=#eee;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="400" height="230" as="geometry" />
        </mxCell>

        <!-- ===== USE CASE ===== -->
        <mxCell id="usecase_header" value="&lt;b&gt;Use Case: Object Detection 3cm-100cm&lt;/b&gt;" style="text;html=1;fontSize=16;fontColor=#00ff88;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="360" width="400" height="25" as="geometry" />
        </mxCell>

        <mxCell id="usecase" value="&lt;font style=&quot;font-size:11px&quot;&gt;• Detect objects from &lt;b&gt;3cm to 100cm&lt;/b&gt;&lt;br&gt;• Through-material detection (works through plastic, wood)&lt;br&gt;• Not affected by dust, rain, lighting conditions&lt;br&gt;• Human presence detection&lt;br&gt;• Micro-motion detection (breathing, heartbeat)&lt;br&gt;• Distance measurement with ~2.5mm resolution&lt;br&gt;• Works in complete darkness&lt;br&gt;• Low power — suitable for battery operation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#00ff88;strokeWidth=2;fontSize=11;fontColor=#eee;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="400" height="150" as="geometry" />
        </mxCell>

        <!-- ===== MODULE PINOUT (MX1.25 10-pin) ===== -->
        <mxCell id="pinout_header" value="&lt;b&gt;Module Pinout (MX1.25 10-pin Header)&lt;/b&gt;" style="text;html=1;fontSize=16;fontColor=#ff8800;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="400" height="25" as="geometry" />
        </mxCell>

        <mxCell id="module_box" value="&lt;b&gt;Waveshare A121 Range Sensor Module&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#888&quot;&gt;STM32L431 + Acconeer A121 + Fresnel Lens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;strokeColor=#ff8800;strokeWidth=2;fontSize=13;fontColor=#eee;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="400" height="350" as="geometry" />
        </mxCell>

        <!-- Pin table -->
        <mxCell id="pin1" value="&lt;b&gt;1 — 5V&lt;/b&gt; (Power)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ff4444;strokeColor=#333;fontSize=11;fontColor=#fff;" vertex="1" parent="1">
          <mxGeometry x="540" y="155" width="170" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pin2" value="&lt;b&gt;2 — GND&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333;strokeColor=#333;fontSize=11;fontColor=#fff;" vertex="1" parent="1">
          <mxGeometry x="540" y="185" width="170" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pin3" value="&lt;b&gt;3 — RXD&lt;/b&gt; (UART in)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4488ff;strokeColor=#333;fontSize=11;fontColor=#fff;" vertex="1" parent="1">
          <mxGeometry x="540" y="215" width="170" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pin4" value="&lt;b&gt;4 — TXD&lt;/b&gt; (UART out)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4488ff;strokeColor=#333;fontSize=11;fontColor=#fff;" vertex="1" parent="1">
          <mxGeometry x="540" y="245" width="170" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pin5" value="&lt;b&gt;5 — SDA&lt;/b&gt; (I2C data)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00ff88;strokeColor=#333;fontSize=11;fontColor=#000;" vertex="1" parent="1">
          <mxGeometry x="540" y="275" width="170" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pin6" value="&lt;b&gt;6 — SCL&lt;/b&gt; (I2C clock)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00ff88;strokeColor=#333;fontSize=11;fontColor=#000;" vertex="1" parent="1">
          <mxGeometry x="540" y="305" width="170" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pin7" value="&lt;b&gt;7 — MCU_INT&lt;/b&gt; (Interrupt)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ff8800;strokeColor=#333;fontSize=11;fontColor=#000;" vertex="1" parent="1">
          <mxGeometry x="540" y="335" width="170" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pin8" value="&lt;b&gt;8 — WAKE_UP&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ff8800;strokeColor=#333;fontSize=11;fontColor=#000;" vertex="1" parent="1">
          <mxGeometry x="540" y="365" width="170" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pin9" value="&lt;b&gt;9 — GPIO0&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#555;strokeColor=#333;fontSize=11;fontColor=#fff;" vertex="1" parent="1">
          <mxGeometry x="540" y="395" width="170" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pin10" value="&lt;b&gt;10 — GPIO1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#555;strokeColor=#333;fontSize=11;fontColor=#fff;" vertex="1" parent="1">
          <mxGeometry x="540" y="425" width="170" height="25" as="geometry" />
        </mxCell>

        <!-- Pin description -->
        <mxCell id="pin_desc" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b style=&quot;color:#4488ff&quot;&gt;UART:&lt;/b&gt; Primary host interface (TX/RX)&lt;br&gt;Register protocol for radar commands&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#00ff88&quot;&gt;I2C:&lt;/b&gt; Alternative host interface&lt;br&gt;Same register protocol as UART&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#ff8800&quot;&gt;INT:&lt;/b&gt; Goes LOW→HIGH when&lt;br&gt;measurement complete&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#ff8800&quot;&gt;WAKE_UP:&lt;/b&gt; Wake module from sleep&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#888&quot;&gt;GPIO0/1:&lt;/b&gt; General purpose IO&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#ff4444&quot;&gt;NOTE: 5V power!&lt;/b&gt; Module has&lt;br&gt;onboard regulator&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#555;fontSize=10;fontColor=#aaa;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="155" width="170" height="180" as="geometry" />
        </mxCell>

        <!-- NOTE: pinout is approximate — verify with actual module -->
        <mxCell id="pin_note" value="&lt;font style=&quot;font-size:10px;color:#00ff88&quot;&gt;&lt;b&gt;CONFIRMED PINOUT:&lt;/b&gt; 5V, GND, RXD, TXD, SDA, SCL, MCU_INT, WAKE_UP, GPIO0, GPIO1&lt;/font&gt;" style="text;html=1;fontSize=10;fontColor=#ff4444;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="455" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- ===== WIRING TO ESP32-P4 ===== -->
        <mxCell id="wiring_header" value="&lt;b&gt;Wiring to ESP32-P4 (Planned)&lt;/b&gt;" style="text;html=1;fontSize=16;fontColor=#9673a6;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="560" width="400" height="25" as="geometry" />
        </mxCell>

        <mxCell id="wiring" value="&lt;font style=&quot;font-size:12px;font-family:monospace&quot;&gt;A121 Module       ESP32-P4 (40-pin)&lt;br&gt;───────────       ─────────────────&lt;br&gt;5V          ←───  5V (USB or external)&lt;br&gt;GND         ←───  GND&lt;br&gt;RXD         ←───  P4 UART TX (GPIO ??)&lt;br&gt;TXD         ───→  P4 UART RX (GPIO ??)&lt;br&gt;MCU_INT     ───→  P4 GPIO ?? (input)&lt;br&gt;WAKE_UP     ←───  P4 GPIO ?? (output)&lt;br&gt;&lt;br&gt;&lt;b&gt;OR via I2C:&lt;/b&gt;&lt;br&gt;SDA         ←──→  GPIO 7 (shared I2C bus)&lt;br&gt;SCL         ←───  GPIO 8 (shared I2C bus)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#9673a6;strokeWidth=2;fontSize=11;fontColor=#eee;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="590" width="400" height="200" as="geometry" />
        </mxCell>

        <!-- ===== ARCHITECTURE ===== -->
        <mxCell id="arch_header" value="&lt;b&gt;Internal Architecture&lt;/b&gt;" style="text;html=1;fontSize=16;fontColor=#4488ff;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="500" width="400" height="25" as="geometry" />
        </mxCell>

        <mxCell id="arch" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;A121 Radar Chip:&lt;/b&gt;&lt;br&gt;• TX antenna → 60GHz pulse&lt;br&gt;• RX antenna → reflected signal&lt;br&gt;• Baseband processor → range data&lt;br&gt;• SPI → STM32 MCU on module&lt;br&gt;&lt;br&gt;&lt;b&gt;STM32L431 MCU:&lt;/b&gt;&lt;br&gt;• Runs Acconeer RSS (Radar System Software)&lt;br&gt;• Processes radar data into distance/presence&lt;br&gt;• Exposes UART/I2C register protocol to host&lt;br&gt;• Can run standalone applications&lt;br&gt;&lt;br&gt;&lt;b&gt;Fresnel Lens:&lt;/b&gt;&lt;br&gt;• Focuses 60GHz beam&lt;br&gt;• Improves detection range and accuracy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#4488ff;strokeWidth=2;fontSize=11;fontColor=#eee;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="530" width="400" height="250" as="geometry" />
        </mxCell>

        <!-- Branding -->
        <mxCell id="brand" value="&lt;b&gt;riscvml.org — SvBlocks by SVB&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#00ff88;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="810" width="400" height="25" as="geometry" />
        </mxCell>

        <!-- Sources -->
        <mxCell id="sources" value="&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;Sources: waveshare.com/a121-range-sensor.htm | Acconeer A121 Datasheet v1.5 | mouser.com&lt;/font&gt;" style="text;html=1;fontSize=9;fontColor=#555;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="840" width="600" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
