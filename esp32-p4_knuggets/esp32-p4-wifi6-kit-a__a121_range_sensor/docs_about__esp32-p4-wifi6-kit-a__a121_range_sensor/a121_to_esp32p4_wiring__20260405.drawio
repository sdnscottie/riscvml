        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;A121 Range Sensor → ESP32-P4 Wiring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#888&quot;&gt;Waveshare A121 (MX1.25 10-pin) to Waveshare ESP32-P4-WIFI6 Kit A (40-pin header)&lt;br&gt;SvBlock by SVB — riscvml.org&lt;/font&gt;" style="text;html=1;fontSize=18;fontColor=#00ff88;align=center;verticalAlign=middle;" vertex="1" parent="1">
