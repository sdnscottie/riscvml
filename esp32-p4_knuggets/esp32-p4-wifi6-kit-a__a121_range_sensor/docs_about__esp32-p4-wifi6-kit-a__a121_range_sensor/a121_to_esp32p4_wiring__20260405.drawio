  <diagram name="A121 to ESP32-P4 Wiring" id="a121-wiring">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#1a1a2e" math="0" shadow="0">
      <root>
