        </mxCell>

        <!-- ===== INTERFACE NOTE ===== -->
        <mxCell id="if_note" value="&lt;b&gt;Interface Options&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#4488ff&quot;&gt;Option A: UART&lt;/b&gt; (recommended)&lt;br&gt;Connect RXD/TXD — simple serial protocol&lt;br&gt;Register read/write commands&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#00ff88&quot;&gt;Option B: I2C&lt;/b&gt;&lt;br&gt;Connect SDA/SCL to GPIO 7/8&lt;br&gt;Shared bus with touch display backlight&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#ff8800&quot;&gt;Both need:&lt;/b&gt; 5V + GND + MCU_INT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#555;strokeWidth=1;fontSize=11;fontColor=#eee;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="500" width="300" height="170" as="geometry" />
