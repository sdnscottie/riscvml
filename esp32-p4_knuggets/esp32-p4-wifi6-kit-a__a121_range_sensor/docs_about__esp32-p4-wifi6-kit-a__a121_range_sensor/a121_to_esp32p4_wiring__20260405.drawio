        <!-- GPIO0/1 not connected -->
        <mxCell id="nc_label" value="&lt;font style=&quot;font-size:10px;color:#555&quot;&gt;GPIO0, GPIO1 — not connected (reserved)&lt;/font&gt;" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1">
